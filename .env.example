# Amazon SES sends Meet Genie and sign-in requests. The sender must be verified in this region.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
SES_FROM=support@mench.com
LEAD_INBOX=support@superhost.management

# Optional fallback if AWS keys are not set. RESEND_FROM must be a verified Resend sender.
RESEND_API_KEY=
RESEND_FROM=
