8:["$","$1","c",{"children":[[["$","section",null,{"id":"$undefined","className":"relative py-24 md:py-32 pb-0","children":["$","div",null,{"className":"mx-auto w-full px-5 max-w-6xl","children":[["$","p",null,{"className":"text-center text-[0.72rem] font-bold tracking-[0.22em] text-[#d4af37] uppercase","children":"Guarantee"}],["$","h1",null,{"className":"mx-auto w-full text-center font-display text-[3rem] leading-[0.98] font-bold tracking-[-0.035em] text-ink md:text-[clamp(1.92rem,4vw,3.52rem)] mt-4 max-w-4xl","children":"Every Interaction Human-Defined & Human-Reviewed"}],["$","p",null,{"className":"mx-auto max-w-2xl text-center text-base leading-relaxed text-mist sm:text-lg mt-5","children":"Genie only detects patterns a person has already written. It does not invent a next step. If an inbound message matches none of those patterns, Genie does not act. Every new company adopts our standard policy, fully defined by us, then customizes it in onboarding and keeps fine-tuning it later, so the behavior is precisely theirs. That is how Genie can resolve the great majority of inquiries and still stay predictable: hundreds of distinct patterns, each one human-defined, each one adjustable for that company."}],["$","div",null,{"className":"mt-8 grid gap-4 md:grid-cols-3","children":[["$","article",null,{"className":"rounded-[24px] border border-[#d4af37]/35 p-5 text-center","children":[["$","h2",null,{"className":"text-lg text-ink","children":"If it isn’t written, it doesn’t happen"}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-mist","children":"Genie has no move outside the policy. Unmatched messages wait for a person. People keep exceptions, approvals over the line, and anything that still needs judgment."}]]}],["$","article",null,{"className":"rounded-[24px] border border-[#d4af37]/35 p-5 text-center","children":[["$","h2",null,{"className":"text-lg text-ink","children":"Personalize & Adopt our Policy Tree"}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-mist","children":"This is what we have been building. It gives Genie full driving capabilities while ensuring every interaction stays human controlled."}]]}],["$","article",null,{"className":"rounded-[24px] border border-[#d4af37]/35 p-5 text-center","children":[["$","h2",null,{"className":"text-lg text-ink","children":"Yours to rewrite"}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-mist","children":"The starting policy is ours. Onboarding makes it yours, and later fine-tuning keeps it yours. Tone, resolution, and the action on each pattern are instructions you set."}]]}]]}]]}]}],["$","$Ld",null,{"intro":false}]],[["$","script","script-0",{"src":"/_next/static/chunks/1f3lwklm8tyy6.js","async":true,"nonce":"$undefined"}]],["$","$Le",null,{"children":["$","$f",null,{"name":"Next.MetadataOutlet","children":"$@10"}]}]]}]
